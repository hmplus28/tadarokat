# کپی کنید به نام .env و مقادیر را تنظیم کنید
# copy .env.example .env

# امنیت — در production حتماً عوض کنید
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=False

# آدرس‌های مجاز (با کاما جدا)
ALLOWED_HOSTS=localhost,127.0.0.1

# پورت دسترسی در مرورگر
APP_PORT=8000

# تنظیمات Django داخل Docker
DJANGO_SETTINGS_MODULE=config.settings_docker

# CSRF — اگر از IP یا دامنه دیگر وارد می‌شوید اضافه کنید
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Redis (اختیاری — فقط با docker compose --profile redis up)
# REDIS_URL=redis://redis:6379/0

# سرور: python manage.py runserver 0.0.0.0:8000 (داخل Docker)